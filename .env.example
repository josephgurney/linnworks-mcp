# Copy this file to .env and fill in your credentials.
# .env is gitignored — never commit the real file.
#
# How to get these values:
#   1. Create an app in the Linnworks developer portal to get APPLICATION_ID + APPLICATION_SECRET
#   2. Visit https://apps.linnworks.net/Authorization/Authorize/{LINNWORKS_APPLICATION_ID}
#      while logged into Linnworks — the Permanent Token is shown on that page
#   3. Paste the Permanent Token below as LINNWORKS_INSTALLATION_TOKEN

LINNWORKS_APPLICATION_ID=your-application-id-here
LINNWORKS_APPLICATION_SECRET=your-application-secret-here
LINNWORKS_INSTALLATION_TOKEN=your-installation-token-here
